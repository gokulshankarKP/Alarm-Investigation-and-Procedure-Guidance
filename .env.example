# Copy to .env and adjust. Plain KEY=VALUE lines only (docker compose and python-dotenv parse this file).
# Never commit .env.

# --- Alarm Management API simulator -------------------------------------------------------
ALARM_API_BASE_URL=http://127.0.0.1:8000
ALARM_API_TOKEN=replace-me-demo-token
# Seed data covers the 183 days ending at this instant ("now" = start-up time).
ALARM_SIM_ANCHOR_TIME=2026-09-30T00:00:00Z
ALARM_SIM_ENABLE_ADMIN=true
ALARM_API_TIMEOUT_S=10
ALARM_API_MAX_RETRIES=2

# --- MCP server (the only path from the copilot to the Alarm API) -------------------------
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_SERVER_URL=http://127.0.0.1:9000/mcp
MCP_AUTH_TOKEN=replace-me-mcp-token
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,alarm-mcp:*
MCP_TOOL_TIMEOUT_S=45

# --- PostgreSQL + pgvector (RAG index) -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=agent_db

# --- LLM (local Ollama) ---------------------------------------------------------------------
LLM_PROVIDER=ollama               # ollama | none (deterministic composer, no LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b             # qwen3:4b is ~2x faster on CPU-only machines
LLM_TIMEOUT_S=600
LLM_MAX_TOKENS=900
COPILOT_INTENT_MODE=hybrid        # hybrid | llm | rules

# --- Embeddings / RAG -----------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama         # ollama | hash (offline, deterministic; CI)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
DOCUMENT_PATH=./rag/documents
RAG_BACKEND=pgvector              # pgvector | memory
RAG_MIN_SIMILARITY=0.62

# --- Copilot backend / GUI ------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_URL=http://127.0.0.1:8080
# Align "now" with the simulator anchor so "last 90 days" hits the seeded history. Empty = real clock.
COPILOT_REFERENCE_TIME=2026-09-30T00:00:00Z
COPILOT_LOOKBACK_DAYS=90
LOG_LEVEL=INFO
